# --- Obligatorias ---
UBERSMITH_API_URL=https://billing.mycompany.com/api/2.0/
UBERSMITH_API_USER=mi_usuario
UBERSMITH_API_TOKEN=mi_token_o_password
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.6-luna          # modelo de OpenAI para leer comentarios

# MySQL remoto. Si MYSQL_DATABASE no existe se crea (el usuario necesita permiso CREATE); las tablas también.
# Dentro de Docker, localhost se traduce a host.docker.internal (MySQL en la misma máquina).
# Para un servidor remoto, pon el hostname o la IP (ej. db.mycompany.com).
MYSQL_HOST=db.mycompany.com
MYSQL_USER=connex
MYSQL_PASSWORD=mi_password
MYSQL_DATABASE=connexmonitor       # letras, números y _
# MYSQL_PORT=3306
# MYSQL_SSL_CA=/certs/ca.pem        # CA para TLS; en Docker monta ./certs (ver docker-compose.yml)
# MYSQL_WAIT_ATTEMPTS=30            # reintentos al arrancar el contenedor
# MYSQL_WAIT_SECONDS=2

# --- Opcionales (ya tienen default; descomenta para cambiarlas) ---

# SUPPORT_QUEUE_ID=57               # cola por defecto de Ubersmith
# CONNEX_QUEUE_DISCONNECT=57        # cola para pedir desconexión (si no, usa SUPPORT_QUEUE_ID)

# CONNEX_CONCURRENCY=8              # clientes analizados a la vez (Ubersmith + OpenAI)
# CONNEX_PAGE_SIZE=1000             # ítems por petición; en pruebas client.list aguantó hasta 12000 en ~4s
# CONNEX_DRY_RUN=1                  # 1 = no crea tickets; 0 = POST real
# CONNEX_INTERVAL_SECONDS=3600      # segundos entre ciclos del bot (1 hora)
# CONNEX_LOCK_TTL_SECONDS=1800      # candado en MySQL para no solapar dos ciclos; se renueva por cliente
# CONNEX_OPEN_TICKET_MAX_AGE_DAYS=5 # no postear si hay ticket abierto del servicio en la cola (días); también es la pausa tras un ticket "Closed Incomplete"
# CONNEX_COMMENT_LIMIT=25           # cuántos comentarios recientes se mandan a OpenAI
# CONNEX_COMMENT_MAX_CHARS=400      # tope de caracteres por comentario
# CONNEX_ANALYSIS_TTL_SECONDS=86400 # caché del análisis de OpenAI en MySQL (1 día; 0 = sin caché)
# CONNEX_INTERNAL_TICKET=1          # 1 = ticket interno (staff), 0 = visible al cliente
# CONNEX_NO_NOTIFICATION=1          # 1 = no envía email al crear el ticket
# CONNEX_TICKET_PRIORITY=1          # 0 baja, 1 normal, 2 alta, 3 urgente
# CONNEX_TICKET_AUTHOR=bot@mycompany.com  # email autor del ticket; si no, usa el usuario de API